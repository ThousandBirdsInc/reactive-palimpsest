# syntax=docker/dockerfile:1.7
# PaaS image for the Kubernetes/CloudNativePG runtime: the control-plane,
# gateway, and db-proxy binaries + the `palimpsest` sync engine, on a Debian
# runtime. The Helm chart (paas/deploy/helm/palimpsest-paas) runs different
# entrypoints from this one image:
#   - control-plane: overrides command to `palimpsest-paas-control-plane serve-sql-api`
#   - gateway:       uses the image ENTRYPOINT (palimpsest-paas-gateway)
#   - db-proxy:      overrides command to ["db_proxy"]  (the db-proxy binary,
#                    installed as `db_proxy` to match values.dbProxy.command)
#
# Build (from the repo root):
#   docker build -f Dockerfile.paas -t paas:dev .
#
# Toolchain is `rust:1-bookworm` (>= 1.88, per transitive deps). cargo-chef is
# intentionally not used (0.1.68 can't parse an edition2024 recipe).

ARG RUST_VERSION=1-bookworm

FROM rust:${RUST_VERSION} AS builder
# protoc is required by palimpsest-proto's build script.
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN cargo build --release \
        --bin palimpsest \
        --bin palimpsest-paas-control-plane \
        --bin palimpsest-paas-gateway \
        --bin palimpsest-paas-db-proxy \
        --bin palimpsest-paas-sync-wrapper \
    && strip \
        target/release/palimpsest \
        target/release/palimpsest-paas-control-plane \
        target/release/palimpsest-paas-gateway \
        target/release/palimpsest-paas-db-proxy \
        target/release/palimpsest-paas-sync-wrapper

FROM debian:bookworm-slim AS runtime
# ca-certificates: outbound TLS (k8s API, ACME). curl: probes/debugging.
# postgresql-client: psql/pg_isready for DDL apply + diagnostics.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl postgresql-client \
    && rm -rf /var/lib/apt/lists/*
# The control-plane's CloudNativePG runtime shells out to `kubectl` to apply
# managed Cluster manifests (using the pod's in-cluster ServiceAccount).
ARG KUBECTL_VERSION=v1.31.4
ARG TARGETARCH=arm64
RUN curl -fsSLo /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
    && chmod 0755 /usr/local/bin/kubectl
COPY --from=builder /workspace/target/release/palimpsest /usr/local/bin/palimpsest
COPY --from=builder /workspace/target/release/palimpsest-paas-control-plane /usr/local/bin/palimpsest-paas-control-plane
COPY --from=builder /workspace/target/release/palimpsest-paas-gateway /usr/local/bin/palimpsest-paas-gateway
# Installed as `db_proxy` to match the chart's values.dbProxy.command (["db_proxy"]).
COPY --from=builder /workspace/target/release/palimpsest-paas-db-proxy /usr/local/bin/db_proxy
COPY --from=builder /workspace/target/release/palimpsest-paas-sync-wrapper /usr/local/bin/palimpsest-paas-sync-wrapper
# Runs non-root to match the chart's securityContext (runAsUser 65532).
USER 65532:65532
EXPOSE 8088 8080 5432
ENTRYPOINT ["palimpsest-paas-gateway"]
