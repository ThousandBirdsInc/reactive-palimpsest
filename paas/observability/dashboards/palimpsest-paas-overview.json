{
  "title": "Palimpsest PaaS Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["palimpsest", "paas"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Gateway Requests",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(palimpsest_gateway_requests_total[5m]))",
          "legendFormat": "requests"
        },
        {
          "expr": "sum(rate(palimpsest_gateway_rejected_requests_total[5m]))",
          "legendFormat": "rejected"
        },
        {
          "expr": "sum(rate(palimpsest_gateway_rate_limited_requests_total[5m]))",
          "legendFormat": "rate limited"
        }
      ]
    },
    {
      "id": 2,
      "title": "Gateway Egress",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(palimpsest_gateway_egress_bytes_total[5m])) by (environment_id)",
          "legendFormat": "{{environment_id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Managed Postgres Backup Age",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "time() - palimpsest_managed_postgres_last_successful_backup_timestamp_seconds",
          "legendFormat": "{{cluster_id}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Managed Postgres WAL Archive Failures",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "increase(palimpsest_managed_postgres_wal_archives_failed_total[1h])",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 5,
      "title": "Quota Usage",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "palimpsest_paas_quota_usage_ratio",
          "legendFormat": "{{environment_id}} {{metric}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Billing Export Failures",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "increase(palimpsest_paas_billing_exports_failed_total[1h])",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 7,
      "title": "Managed Postgres Lifecycle",
      "type": "stat",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum by (state) (palimpsest_managed_postgres_cluster_lifecycle_state)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Managed Postgres Storage Allocation",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "palimpsest_managed_postgres_storage_allocated_gib",
          "legendFormat": "{{cluster_id}} {{host_id}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Host Storage Pressure",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "palimpsest_managed_postgres_storage_used_ratio",
          "legendFormat": "{{host_id}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "WAL Archive Age",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "time() - palimpsest_managed_postgres_last_successful_wal_archive_timestamp_seconds",
          "legendFormat": "{{cluster_id}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "PITR Check Age",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "time() - palimpsest_managed_postgres_last_successful_pitr_check_timestamp_seconds",
          "legendFormat": "{{cluster_id}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Restore Drill Age",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "time() - palimpsest_managed_postgres_last_successful_restore_drill_timestamp_seconds",
          "legendFormat": "{{cluster_id}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Standby Check Age",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "time() - palimpsest_managed_postgres_last_successful_standby_check_timestamp_seconds",
          "legendFormat": "{{cluster_id}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Node Agent Command Failures",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 46, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "increase(palimpsest_paas_agent_commands_failed_total[1h])",
          "legendFormat": "failures"
        }
      ]
    }
  ]
}
