# Palimpsest PaaS local development stack.
#
# Run from this directory:
#
#   cd paas
#   tilt up
#
# This starts:
# - control-plane PostgreSQL 18 through Docker Compose
# - Flyway migrations
# - SQL-backed Rust control-plane API on 127.0.0.1:8088
# - a local Rust node-agent poll loop for managed Postgres commands
# - the React PaaS UI on 127.0.0.1:8090

CONTROL_PLANE_URL = "http://127.0.0.1:8088"
DATABASE_URL = "postgres://palimpsest_control:palimpsest_control@127.0.0.1:54330/palimpsest_control"
AGENT_HOST_ID = "local-dev-host"
AGENT_RUNTIME_ROOT = "/tmp/palimpsest-paas-tilt"
AGENT_OBJECT_STORE = "/tmp/palimpsest-paas-tilt-object-store"
AGENT_FIRST_PORT = "56000"

CONTROL_PLANE_API_DEPS = [
    "../Cargo.toml",
    "../Cargo.lock",
    "crates/palimpsest-paas-control-plane/src",
    "crates/palimpsest-paas-core/src",
]

NODE_AGENT_DEPS = [
    "../Cargo.toml",
    "../Cargo.lock",
    "crates/palimpsest-paas-node-agent/src",
    "crates/palimpsest-paas-core/src",
]

PAAS_SMOKE_DEPS = [
    "control-plane/smoke-local.sh",
    "control-plane/docker-compose.yaml",
    "control-plane/flyway.conf",
    "control-plane/migrations",
    "examples",
    "crates",
]

local_resource(
    "control-plane-postgres",
    cmd="docker compose -f control-plane/docker-compose.yaml up -d control-plane-postgres",
    deps=["control-plane/docker-compose.yaml"],
)

local_resource(
    "control-plane-migrations",
    cmd="docker compose -f control-plane/docker-compose.yaml run --rm flyway",
    deps=["control-plane/flyway.conf", "control-plane/migrations"],
    resource_deps=["control-plane-postgres"],
)

local_resource(
    "control-plane-api",
    serve_cmd=(
        "cd .. && " +
        "PALIMPSEST_PAAS_SECRET_PROVIDER=local-dev " +
        "cargo run -p palimpsest-paas-control-plane -- " +
        "serve-sql-api 127.0.0.1:8088 " +
        DATABASE_URL
    ),
    deps=CONTROL_PLANE_API_DEPS,
    resource_deps=["control-plane-migrations"],
    links=[CONTROL_PLANE_URL + "/metrics"],
)

local_resource(
    "seed-local-scope",
    cmd=r"""
set -eu

api="http://127.0.0.1:8088"

echo "waiting for control-plane API at ${api}"
attempts=0
until curl --silent --fail --connect-timeout 1 --max-time 2 "${api}/metrics" >/dev/null; do
  attempts=$((attempts + 1))
  if [ "${attempts}" -ge 120 ]; then
    echo "control-plane API did not become ready within 120 seconds" >&2
    exit 1
  fi
  echo "control-plane API not ready yet (${attempts}/120)"
  sleep 1
done
echo "control-plane API is ready"

post_or_conflict_ok() {
  path="$1"
  body="$2"
  response="$(mktemp)"
  status="$(curl --silent --show-error \
    --connect-timeout 1 \
    --max-time 10 \
    -H "content-type: application/json" \
    -H "x-actor-id: tilt-local" \
    -X POST \
    --data "${body}" \
    --output "${response}" \
    --write-out "%{http_code}" \
    "${api}${path}")"
  if [ "${status}" -ge 200 ] && [ "${status}" -lt 300 ]; then
    rm -f "${response}"
    return 0
  fi
  if [ "${status}" = "409" ]; then
    rm -f "${response}"
    return 0
  fi
  cat "${response}" >&2 || true
  rm -f "${response}"
  echo "POST ${path} returned HTTP ${status}" >&2
  exit 1
}

post_or_conflict_ok "/v1/organizations" '{"organization_id":"org_123","name":"Local Tilt Org"}'
post_or_conflict_ok "/v1/projects" '{"project_id":"project_123","organization_id":"org_123","name":"Local Tilt Project"}'
post_or_conflict_ok "/v1/environments" '{"environment_id":"env_123","organization_id":"org_123","project_id":"project_123","name":"Local Tilt","region":"local"}'
""",
    resource_deps=["control-plane-api"],
)

local_resource(
    "node-agent",
    serve_cmd=(
        "cd .. && " +
        "export PALIMPSEST_PAAS_AGENT_HOST_ID=" + AGENT_HOST_ID + " && " +
        "export PALIMPSEST_PAAS_AGENT_RUNTIME_ROOT=" + AGENT_RUNTIME_ROOT + " && " +
        "export PALIMPSEST_PAAS_AGENT_FIRST_PORT=" + AGENT_FIRST_PORT + " && " +
        "export PALIMPSEST_PAAS_BACKUP_OBJECT_STORE_DIR=" + AGENT_OBJECT_STORE + " && " +
        "cargo run -p palimpsest-paas-node-agent -- register " + CONTROL_PLANE_URL + " && " +
        "while true; do " +
        "cargo run -p palimpsest-paas-node-agent -- heartbeat " + CONTROL_PLANE_URL + " || true; " +
        "cargo run -p palimpsest-paas-node-agent -- poll-once-container " + CONTROL_PLANE_URL + " || true; " +
        "sleep 5; " +
        "done"
    ),
    deps=NODE_AGENT_DEPS,
    resource_deps=["seed-local-scope"],
)

local_resource(
    "paas-ui-deps",
    cmd="cd ui && npm ci",
    deps=["ui/package.json", "ui/package-lock.json"],
)

local_resource(
    "paas-ui",
    serve_cmd="cd ui && npm run dev -- --host 127.0.0.1",
    deps=[
        "ui/index.html",
        "ui/package.json",
        "ui/package-lock.json",
        "ui/tsconfig.json",
        "ui/vite.config.ts",
        "ui/src",
    ],
    resource_deps=["paas-ui-deps", "control-plane-api"],
    links=["http://127.0.0.1:8090/"],
)

local_resource(
    "paas-smoke",
    cmd=(
        "COMPOSE_PROJECT_NAME=palimpsest-paas-smoke " +
        "PALIMPSEST_PAAS_CONTROL_PLANE_POSTGRES_CONTAINER=palimpsest-control-plane-postgres-smoke " +
        "PALIMPSEST_PAAS_CONTROL_PLANE_POSTGRES_VOLUME=palimpsest-control-plane-postgres-smoke-data " +
        "PALIMPSEST_PAAS_CONTROL_PLANE_POSTGRES_PORT=54331 " +
        "PALIMPSEST_PAAS_API_ADDR=127.0.0.1:8188 " +
        "PALIMPSEST_PAAS_DATABASE_URL=postgres://palimpsest_control:palimpsest_control@127.0.0.1:54331/palimpsest_control " +
        "PALIMPSEST_PAAS_AGENT_FIRST_PORT=57000 " +
        "PALIMPSEST_PAAS_AGENT_RUNTIME_ROOT=/tmp/palimpsest-paas-smoke-tilt " +
        "PALIMPSEST_PAAS_BACKUP_OBJECT_STORE_DIR=/tmp/palimpsest-paas-smoke-tilt-object-store " +
        "PALIMPSEST_PAAS_BILLING_EXPORT_DIR=/tmp/palimpsest-paas-smoke-tilt-billing-exports " +
        "control-plane/smoke-local.sh"
    ),
    deps=PAAS_SMOKE_DEPS,
    trigger_mode=TRIGGER_MODE_MANUAL,
)
