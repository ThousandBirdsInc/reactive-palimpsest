#
# Pre-create the cgroup v1 slices that systemd does not delegate (cpuset,
# hugetlb) so the kubelet's cgroupfs driver finds every controller path. Runs as
# a kubelet ExecStartPre inside the kind node. Required when the host runs
# cgroup v1 (hybrid) rather than unified cgroup v2 -- e.g. a kind node nested
# inside a cgroup-v1 microVM.
for c in cpuset hugetlb; do
  base="/sys/fs/cgroup/$c"
  [ -d "$base" ] || continue
  for g in kubelet kubepods system runtime podruntime; do
    mkdir -p "$base/$g" 2>/dev/null || true
  done
  # cpuset child cgroups are unusable until cpus/mems are seeded from the root.
  if [ -e "$base/cpuset.cpus" ]; then
    for g in kubelet kubepods system runtime podruntime; do
      [ -d "$base/$g" ] || continue
      cat "$base/cpuset.cpus" > "$base/$g/cpuset.cpus" 2>/dev/null || true
      cat "$base/cpuset.mems" > "$base/$g/cpuset.mems" 2>/dev/null || true
    done
  fi
done
exit 0
