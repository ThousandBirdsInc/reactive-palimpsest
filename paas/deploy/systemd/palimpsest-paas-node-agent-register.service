[Unit]
Description=Register Palimpsest PaaS node host
Documentation=https://github.com/thousandbirds/palimpsest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=palimpsest
Group=palimpsest
EnvironmentFile=/etc/palimpsest/paas/node-agent.env
ExecStart=/usr/local/bin/palimpsest-paas-node-agent register ${PALIMPSEST_PAAS_CONTROL_PLANE_URL}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/palimpsest /var/log/palimpsest
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
