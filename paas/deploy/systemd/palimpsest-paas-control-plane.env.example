# Copy to /etc/palimpsest/paas/control-plane.env and edit per control-plane host.

PALIMPSEST_PAAS_CONTROL_PLANE_ADDR=127.0.0.1:18088
PALIMPSEST_PAAS_DATABASE_URL=postgres://palimpsest_control:replace-me@127.0.0.1:5432/palimpsest_control

# Shared bootstrap token for local fallback only. Production-like node-agent
# routes should also set PALIMPSEST_PAAS_AGENT_SIGNING_KEY_BASE64 so each agent
# request must carry a fresh scoped HMAC signature.
PALIMPSEST_PAAS_AGENT_TOKEN=replace-with-issued-agent-token
# Optional shared fallback key used during bootstrap. Once a host has an issued
# PALIMPSEST_PAAS_AGENT_SIGNING_KEY_ID, the control plane validates against the
# per-host credential stored in the metadata database.
PALIMPSEST_PAAS_AGENT_SIGNING_KEY_BASE64=replace-with-32-byte-base64-agent-signing-key

# Local development can use local-dev. Production-like hosts should use
# env-envelope with a 32-byte base64 root key supplied by owned key management.
PALIMPSEST_PAAS_SECRET_PROVIDER=env-envelope
PALIMPSEST_PAAS_SECRET_KEY_REF=control-plane-key-1
PALIMPSEST_PAAS_SECRET_KEY_BASE64=replace-with-32-byte-base64-key

# Run the managed Postgres base-backup scheduler inside serve-sql-api.
PALIMPSEST_PAAS_BACKUP_SCHEDULER_INTERVAL_SECONDS=3600

# Run recoverability schedulers inside serve-sql-api.
PALIMPSEST_PAAS_RESTORE_DRILL_SCHEDULER_INTERVAL_SECONDS=21600
PALIMPSEST_PAAS_RESTORE_DRILL_MAX_AGE_HOURS=168
PALIMPSEST_PAAS_PITR_CHECK_SCHEDULER_INTERVAL_SECONDS=3600
PALIMPSEST_PAAS_PITR_CHECK_MAX_AGE_HOURS=24

# Run customer maintenance-window automation inside serve-sql-api.
PALIMPSEST_PAAS_MAINTENANCE_SCHEDULER_INTERVAL_SECONDS=900
PALIMPSEST_PAAS_MAINTENANCE_TARGET_POSTGRES_VERSION=18.4

# Destination for local-jsonl billing export artifacts.
PALIMPSEST_PAAS_BILLING_EXPORT_DIR=/var/lib/palimpsest-control-plane/billing-exports

# Require HMAC signatures on data-plane usage events in production-like runs.
PALIMPSEST_PAAS_USAGE_EVENT_SIGNING_KEY_ID=usage-events-key-1
PALIMPSEST_PAAS_USAGE_EVENT_SIGNING_KEY_BASE64=replace-with-32-byte-base64-usage-event-key
