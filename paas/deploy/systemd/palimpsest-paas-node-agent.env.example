# Copy to /etc/palimpsest/paas/node-agent.env and edit per host.

PALIMPSEST_PAAS_CONTROL_PLANE_URL=http://127.0.0.1:8088
PALIMPSEST_PAAS_AGENT_HOST_ID=replace-with-stable-host-id
PALIMPSEST_PAAS_AGENT_TOKEN=replace-with-issued-agent-token
PALIMPSEST_PAAS_AGENT_SIGNING_KEY_ID=replace-with-issued-agent-signing-key-id
PALIMPSEST_PAAS_AGENT_SIGNING_KEY_BASE64=replace-with-32-byte-base64-agent-signing-key
PALIMPSEST_PAAS_AGENT_RUNTIME_ROOT=/var/lib/palimpsest
PALIMPSEST_PAAS_POSTGRES_BIN_DIR=/usr/lib/postgresql/18/bin

# Use poll-once for hosts with local PostgreSQL 18 binaries. Use
# poll-once-container only for controlled test hosts that intentionally run
# PostgreSQL through the PostgreSQL 18 container image.
PALIMPSEST_PAAS_NODE_AGENT_POLL_COMMAND=poll-once
