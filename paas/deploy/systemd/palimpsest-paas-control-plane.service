[Unit]
Description=Palimpsest PaaS SQL control plane
Documentation=https://github.com/thousandbirds/palimpsest
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=palimpsest
Group=palimpsest
EnvironmentFile=/etc/palimpsest/paas/control-plane.env
ExecStart=/usr/local/bin/palimpsest-paas-control-plane serve-sql-api ${PALIMPSEST_PAAS_CONTROL_PLANE_ADDR} ${PALIMPSEST_PAAS_DATABASE_URL}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/palimpsest-control-plane /var/log/palimpsest
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
