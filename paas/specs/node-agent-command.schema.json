{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/node-agent-command.schema.json",
  "title": "Palimpsest Node Agent Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "cluster_id", "action"],
  "properties": {
    "command_id": { "type": "string", "minLength": 1 },
    "cluster_id": { "type": "string", "minLength": 1 },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "postgres_version", "data_dir", "port"],
          "properties": {
            "kind": { "const": "prepare_postgres" },
            "postgres_version": {
              "type": "string",
              "pattern": "^(1[8-9]|[2-9][0-9])([.-].*)?$"
            },
            "data_dir": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "start_postgres" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "stop_postgres" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "data_dir", "tombstone_retention_days"],
          "properties": {
            "kind": { "const": "delete_postgres_data" },
            "data_dir": { "type": "string", "minLength": 1 },
            "tombstone_retention_days": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "data_dir",
            "port",
            "database",
            "roles",
            "publication",
            "replication_slot"
          ],
          "properties": {
            "kind": { "const": "configure_postgres_access" },
            "data_dir": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
            },
            "roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "kind", "password", "privileges"],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
                  },
                  "kind": {
                    "enum": ["app", "migration", "replication", "support"]
                  },
                  "password": { "type": "string", "minLength": 1 },
                  "privileges": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "publication": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
            },
            "replication_slot": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "backup_id",
            "backup_dir",
            "data_dir",
            "primary_conninfo",
            "primary_slot_name",
            "source_data_dir",
            "source_port",
            "database",
            "restore_command"
          ],
          "properties": {
            "kind": { "const": "prepare_postgres_standby" },
            "backup_id": { "type": "string", "minLength": 1 },
            "backup_dir": { "type": "string", "minLength": 1 },
            "data_dir": { "type": "string", "minLength": 1 },
            "target_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "primary_conninfo": { "type": "string", "minLength": 1 },
            "primary_slot_name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
            },
            "source_data_dir": { "type": "string", "minLength": 1 },
            "source_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
            },
            "restore_command": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "report_status" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source_data_dir",
            "source_port",
            "database",
            "slot_name",
            "max_lag_bytes"
          ],
          "properties": {
            "kind": { "const": "check_postgres_standby_lag" },
            "source_data_dir": { "type": "string", "minLength": 1 },
            "source_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
            },
            "slot_name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
            },
            "max_lag_bytes": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "backup_id", "data_dir", "postgres_url", "backup_dir"],
          "properties": {
            "kind": { "const": "run_base_backup" },
            "backup_id": { "type": "string", "minLength": 1 },
            "data_dir": { "type": "string", "minLength": 1 },
            "postgres_url": { "type": "string", "minLength": 1 },
            "backup_dir": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "backup_id", "backup_dir"],
          "properties": {
            "kind": { "const": "delete_backup_data" },
            "backup_id": { "type": "string", "minLength": 1 },
            "backup_dir": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "backup_id",
            "backup_dir",
            "data_dir",
            "restore_command",
            "recovery_target_lsn"
          ],
          "properties": {
            "kind": { "const": "prepare_restore" },
            "backup_id": { "type": "string", "minLength": 1 },
            "backup_dir": { "type": "string", "minLength": 1 },
            "data_dir": { "type": "string", "minLength": 1 },
            "target_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "string", "minLength": 1 },
            "restore_command": { "type": "string", "minLength": 1 },
            "recovery_target_lsn": {
              "anyOf": [
                { "type": "null" },
                { "type": "string", "minLength": 1 }
              ]
            },
            "redaction_policy": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["policy_id", "rules"]
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source_path", "archive_dir", "segment_name"],
          "properties": {
            "kind": { "const": "archive_wal_segment" },
            "source_path": { "type": "string", "minLength": 1 },
            "archive_dir": { "type": "string", "minLength": 1 },
            "segment_name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "data_dir"],
          "properties": {
            "kind": { "const": "promote_postgres_standby" },
            "data_dir": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "data_dir"],
          "properties": {
            "kind": { "const": "fence_postgres_primary" },
            "data_dir": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "data_dir", "storage_gib"],
          "properties": {
            "kind": { "const": "resize_postgres_storage" },
            "data_dir": { "type": "string", "minLength": 1 },
            "storage_gib": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "data_dir", "target_postgres_version"],
          "properties": {
            "kind": { "const": "update_postgres_minor" },
            "data_dir": { "type": "string", "minLength": 1 },
            "target_postgres_version": {
              "type": "string",
              "pattern": "^(1[8-9]|[2-9][0-9])([.-].*)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "data_dir",
            "source_postgres_version",
            "target_postgres_version",
            "strategy"
          ],
          "properties": {
            "kind": { "const": "upgrade_postgres_major" },
            "data_dir": { "type": "string", "minLength": 1 },
            "source_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": { "type": "string", "minLength": 1 },
            "source_postgres_version": {
              "type": "string",
              "pattern": "^(1[8-9]|[2-9][0-9])([.-].*)?$"
            },
            "target_postgres_version": {
              "type": "string",
              "pattern": "^(1[8-9]|[2-9][0-9])([.-].*)?$"
            },
            "strategy": {
              "enum": ["logical_replication_copy", "pg_upgrade_copy"]
            }
          }
        }
      ]
    }
  }
}
