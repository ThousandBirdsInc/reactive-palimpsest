{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/database-proxy-route.schema.json",
  "title": "Palimpsest Database Proxy Route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "listen_addr",
    "upstream_addr",
    "organization_id",
    "project_id",
    "environment_id",
    "cluster_id"
  ],
  "properties": {
    "listen_addr": { "type": "string", "minLength": 1 },
    "upstream_addr": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "cluster_id": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_users": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "allowed_databases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "forbidden_startup_parameters": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_startup_parameters": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "forbidden_simple_query_verbs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "max_simple_query_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "certificate_id",
        "common_name",
        "certificate_secret_ref",
        "private_key_secret_ref",
        "fingerprint_sha256"
      ],
      "properties": {
        "mode": { "const": "terminate_at_proxy" },
        "certificate_id": { "type": "string", "minLength": 1 },
        "common_name": { "type": "string", "minLength": 1 },
        "certificate_secret_ref": { "$ref": "#/$defs/secret_ref" },
        "private_key_secret_ref": { "$ref": "#/$defs/secret_ref" },
        "fingerprint_sha256": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "secret_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_id", "provider", "external_ref"],
      "properties": {
        "secret_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "external_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
