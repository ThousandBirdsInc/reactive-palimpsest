{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/maintenance-window.schema.json",
  "title": "Palimpsest Maintenance Window",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "window_id",
    "organization_id",
    "project_id",
    "environment_id",
    "name",
    "day_of_week",
    "start_time",
    "duration_minutes",
    "auto_minor_upgrades",
    "status"
  ],
  "properties": {
    "window_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "day_of_week": {
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ]
    },
    "start_time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "duration_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "auto_minor_upgrades": { "type": "boolean" },
    "status": { "enum": ["active", "disabled"] }
  }
}
