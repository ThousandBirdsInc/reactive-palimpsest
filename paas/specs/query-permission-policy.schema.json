{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/query-permission-policy.schema.json",
  "title": "Palimpsest Query Permission Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "organization_id",
    "project_id",
    "environment_id",
    "name",
    "table_schema",
    "table_name",
    "operation",
    "principal_claim",
    "predicate_sql",
    "sample_context",
    "status"
  ],
  "properties": {
    "policy_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "table_schema": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
    },
    "table_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
    },
    "operation": { "enum": ["read", "subscribe"] },
    "principal_claim": { "type": "string", "minLength": 1 },
    "predicate_sql": { "type": "string", "minLength": 1 },
    "sample_context": {
      "type": "object",
      "additionalProperties": true
    },
    "status": { "enum": ["draft", "active"] }
  }
}
