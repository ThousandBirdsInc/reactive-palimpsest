{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/managed-postgres-runtime-check.schema.json",
  "title": "Palimpsest Managed Postgres Runtime Check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "check_id",
    "cluster_id",
    "status",
    "connection_count",
    "max_connections",
    "replication_slot_lag_bytes",
    "long_running_query_count",
    "blocked_lock_count",
    "oldest_transaction_age_seconds",
    "autovacuum_running",
    "checked_at",
    "error_message"
  ],
  "properties": {
    "check_id": { "type": "string", "minLength": 1 },
    "cluster_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["healthy", "degraded", "failed"] },
    "connection_count": { "type": "integer", "minimum": 0 },
    "max_connections": { "type": "integer", "minimum": 0 },
    "replication_slot_lag_bytes": {
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    },
    "long_running_query_count": { "type": "integer", "minimum": 0 },
    "blocked_lock_count": { "type": "integer", "minimum": 0 },
    "oldest_transaction_age_seconds": {
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    },
    "autovacuum_running": { "type": "boolean" },
    "checked_at": { "type": "string", "minLength": 1 },
    "error_message": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    }
  }
}
