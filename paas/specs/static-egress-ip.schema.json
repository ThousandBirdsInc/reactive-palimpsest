{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/static-egress-ip.schema.json",
  "title": "Palimpsest Static Egress IP",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "egress_ip_id",
    "organization_id",
    "project_id",
    "environment_id",
    "region",
    "ip_address",
    "provider_ref",
    "status"
  ],
  "properties": {
    "egress_ip_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "ip_address": { "type": "string", "minLength": 1 },
    "provider_ref": { "type": "string", "minLength": 1 },
    "status": { "enum": ["provisioning", "active", "retired"] }
  }
}
