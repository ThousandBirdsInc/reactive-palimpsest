{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/sso-provider.schema.json",
  "title": "Palimpsest SSO Identity Provider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id",
    "organization_id",
    "name",
    "kind",
    "issuer",
    "sso_url",
    "certificate_secret_ref",
    "claim_mappings",
    "status"
  ],
  "properties": {
    "provider_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["saml", "oidc"] },
    "issuer": { "type": "string", "minLength": 1 },
    "sso_url": { "type": "string", "minLength": 1 },
    "certificate_secret_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["secret_id", "provider", "external_ref"],
      "properties": {
        "secret_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "external_ref": { "type": "string", "minLength": 1 }
      }
    },
    "claim_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "field"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 }
        }
      }
    },
    "status": { "enum": ["active", "disabled"] }
  }
}
