{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/node-host-hardening-check.schema.json",
  "title": "Palimpsest Node Host Hardening Check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "check_id",
    "host_id",
    "status",
    "image_ref",
    "os_release",
    "kernel_version",
    "postgres_major_min",
    "container_runtime",
    "disk_encryption",
    "firewall_enabled",
    "unattended_upgrades",
    "checked_at"
  ],
  "properties": {
    "check_id": { "type": "string", "minLength": 1 },
    "host_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passing", "warning", "failing"] },
    "image_ref": { "type": "string", "minLength": 1 },
    "os_release": { "type": "string", "minLength": 1 },
    "kernel_version": { "type": "string", "minLength": 1 },
    "postgres_major_min": { "type": "integer", "minimum": 18 },
    "container_runtime": { "type": "string", "minLength": 1 },
    "disk_encryption": { "type": "boolean" },
    "firewall_enabled": { "type": "boolean" },
    "unattended_upgrades": { "type": "boolean" },
    "last_patched_at": { "type": ["string", "null"] },
    "checked_at": { "type": "string", "minLength": 1 },
    "error_message": { "type": ["string", "null"] }
  }
}
