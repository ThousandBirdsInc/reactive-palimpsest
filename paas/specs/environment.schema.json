{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/environment.schema.json",
  "title": "Palimpsest PaaS Environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization_id", "project_id", "environment_id", "region", "database", "sync"],
  "properties": {
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "database": { "$ref": "#/$defs/database" },
    "sync": { "$ref": "#/$defs/sync_deployment" }
  },
  "$defs": {
    "postgres_version_18_plus": {
      "type": "string",
      "pattern": "^(1[8-9]|[2-9][0-9])([.-].*)?$"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["managed", "local", "external"] },
        "postgres_version": { "$ref": "#/$defs/postgres_version_18_plus" },
        "managed": { "$ref": "#/$defs/managed_postgres" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "enum": ["managed", "local"] } }, "required": ["mode"] },
          "then": { "required": ["postgres_version"] }
        },
        {
          "if": { "properties": { "mode": { "const": "managed" } }, "required": ["mode"] },
          "then": { "required": ["managed"] }
        }
      ]
    },
    "managed_postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "tier", "storage_gib", "backup_policy", "maintenance_policy"],
      "properties": {
        "cluster_id": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "minLength": 1 },
        "storage_gib": { "type": "integer", "minimum": 1 },
        "backup_policy": { "$ref": "#/$defs/backup_policy" },
        "maintenance_policy": { "$ref": "#/$defs/maintenance_policy" },
        "roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/database_role" },
          "default": []
        }
      }
    },
    "database_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "secret_ref", "privileges"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["app", "migration", "replication", "support"] },
        "secret_ref": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/secret_ref" }
          ]
        },
        "privileges": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "secret_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_id", "provider", "external_ref"],
      "properties": {
        "secret_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "external_ref": { "type": "string", "minLength": 1 }
      }
    },
    "backup_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitr_window_hours", "base_backup_interval_hours"],
      "properties": {
        "pitr_window_hours": { "type": "integer", "minimum": 1 },
        "base_backup_interval_hours": { "type": "integer", "minimum": 1 }
      }
    },
    "maintenance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "auto_minor_upgrades"],
      "properties": {
        "window": { "type": "string", "minLength": 1 },
        "auto_minor_upgrades": { "type": "boolean" }
      }
    },
    "sync_deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_id", "config_version"],
      "properties": {
        "deployment_id": { "type": "string", "minLength": 1 },
        "config_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
