{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/clone-redaction-policy.schema.json",
  "title": "Palimpsest Managed Postgres Clone Redaction Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "organization_id",
    "project_id",
    "environment_id",
    "name",
    "status",
    "rules",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "policy_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "disabled"] },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table_schema", "table_name", "column_name", "method"],
        "properties": {
          "table_schema": { "type": "string", "minLength": 1 },
          "table_name": { "type": "string", "minLength": 1 },
          "column_name": { "type": "string", "minLength": 1 },
          "method": { "enum": ["null", "static_value", "hash_sha256"] },
          "static_value": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
