{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/node-host.schema.json",
  "title": "Palimpsest Node Host",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host_id",
    "region",
    "failure_domain",
    "data_root",
    "first_port",
    "state",
    "capacity"
  ],
  "properties": {
    "host_id": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "failure_domain": { "type": "string", "minLength": 1 },
    "data_root": { "type": "string", "minLength": 1 },
    "first_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "state": {
      "enum": ["registering", "active", "draining", "maintenance", "offline"]
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_clusters",
        "assigned_clusters",
        "storage_gib",
        "used_storage_gib"
      ],
      "properties": {
        "max_clusters": { "type": "integer", "minimum": 0 },
        "assigned_clusters": { "type": "integer", "minimum": 0 },
        "storage_gib": { "type": "integer", "minimum": 0 },
        "used_storage_gib": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
