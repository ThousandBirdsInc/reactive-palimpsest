{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/managed-postgres-acme-order.schema.json",
  "title": "Palimpsest Managed Postgres ACME Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "certificate_id",
    "environment_id",
    "ca_provider_id",
    "common_name",
    "challenge_type",
    "challenge_token",
    "key_authorization_secret_ref",
    "csr_secret_ref",
    "directory_url",
    "account_ref",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "order_id": { "type": "string", "minLength": 1 },
    "certificate_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "ca_provider_id": { "type": "string", "minLength": 1 },
    "common_name": { "type": "string", "minLength": 1 },
    "challenge_type": { "enum": ["http_01"] },
    "challenge_token": { "type": "string", "minLength": 1 },
    "key_authorization_secret_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_id", "provider", "external_ref"],
      "properties": {
        "secret_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "external_ref": { "type": "string", "minLength": 1 }
      }
    },
    "csr_secret_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_id", "provider", "external_ref"],
      "properties": {
        "secret_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "external_ref": { "type": "string", "minLength": 1 }
      }
    },
    "directory_url": { "type": "string", "minLength": 1 },
    "account_ref": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["pending_challenge", "ready_to_finalize", "succeeded", "failed"]
    },
    "error_message": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
