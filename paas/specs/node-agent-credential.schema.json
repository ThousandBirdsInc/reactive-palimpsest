{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/node-agent-credential.schema.json",
  "title": "Palimpsest Node Agent Credential",
  "type": "object",
  "additionalProperties": false,
  "required": ["host_id", "key_id", "signing_key_base64"],
  "properties": {
    "host_id": { "type": "string", "minLength": 1 },
    "key_id": { "type": "string", "minLength": 1 },
    "signing_key_base64": { "type": "string", "minLength": 1 }
  }
}
