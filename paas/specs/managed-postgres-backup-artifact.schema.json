{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/managed-postgres-backup-artifact.schema.json",
  "title": "Palimpsest Managed Postgres Backup Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "backup_id",
    "cluster_id",
    "provider",
    "object_uri",
    "manifest_path",
    "manifest_sha256",
    "size_bytes",
    "status",
    "created_at",
    "updated_at",
    "error_message"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "backup_id": { "type": "string", "minLength": 1 },
    "cluster_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "object_uri": { "type": "string", "minLength": 1 },
    "manifest_path": { "type": "string", "minLength": 1 },
    "manifest_sha256": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "size_bytes": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "status": {
      "enum": ["pending", "available", "expired", "deleted", "failed"]
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "error_message": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    }
  }
}
