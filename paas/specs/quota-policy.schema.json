{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/quota-policy.schema.json",
  "title": "Palimpsest Quota Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "organization_id",
    "project_id",
    "environment_id",
    "metric",
    "limit_quantity",
    "window_seconds",
    "enforcement"
  ],
  "properties": {
    "policy_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "metric": {
      "enum": [
        "postgres_storage_gib_hours",
        "postgres_wal_bytes",
        "postgres_backup_bytes",
        "sync_egress_bytes",
        "sync_connection_minutes"
      ]
    },
    "limit_quantity": { "type": "integer", "minimum": 0 },
    "window_seconds": { "type": "integer", "minimum": 1 },
    "enforcement": { "enum": ["reject", "observe"] }
  }
}
