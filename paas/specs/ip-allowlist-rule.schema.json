{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/ip-allowlist-rule.schema.json",
  "title": "Palimpsest IP Allowlist Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "organization_id",
    "project_id",
    "environment_id",
    "name",
    "cidr",
    "purpose",
    "status"
  ],
  "properties": {
    "rule_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
    },
    "purpose": { "enum": ["app", "migration", "support"] },
    "status": { "enum": ["active", "disabled"] }
  }
}
