{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/managed-postgres-backup-retention-policy.schema.json",
  "title": "Palimpsest Managed Postgres Backup Retention Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cluster_id",
    "retention_days",
    "keep_min_successful_backups",
    "enabled",
    "updated_at"
  ],
  "properties": {
    "cluster_id": { "type": "string", "minLength": 1 },
    "retention_days": { "type": "integer", "minimum": 0, "maximum": 3650 },
    "keep_min_successful_backups": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "enabled": { "type": "boolean" },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
