{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/secret-encryption-key.schema.json",
  "title": "Palimpsest Secret Encryption Key",
  "type": "object",
  "additionalProperties": false,
  "required": ["key_ref", "provider", "purpose", "status", "created_at"],
  "properties": {
    "key_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 256 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "enum": ["active", "retiring", "retired"] },
    "created_at": { "type": "string", "minLength": 1 },
    "activated_at": { "type": ["string", "null"] },
    "retired_at": { "type": ["string", "null"] }
  }
}
