{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/gateway-route.schema.json",
  "title": "Palimpsest Gateway Route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "organization_id",
    "project_id",
    "environment_id",
    "sync_endpoint",
    "tls_policy",
    "rate_limit"
  ],
  "properties": {
    "host": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "sync_endpoint": { "type": "string", "minLength": 1 },
    "tls_policy": {
      "oneOf": [
        {
          "type": "string",
          "const": "terminate_at_gateway"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutual_tls_to_sync"],
          "properties": {
            "mutual_tls_to_sync": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ca_secret_ref"],
              "dependentRequired": {
                "client_certificate_secret_ref": ["client_private_key_secret_ref"],
                "client_private_key_secret_ref": ["client_certificate_secret_ref"]
              },
              "properties": {
                "ca_secret_ref": { "type": "string", "minLength": 1 },
                "client_certificate_secret_ref": { "type": "string", "minLength": 1 },
                "client_private_key_secret_ref": { "type": "string", "minLength": 1 },
                "server_name": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_connections", "max_requests_per_minute"],
      "properties": {
        "max_connections": { "type": "integer", "minimum": 1 },
        "max_requests_per_minute": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
