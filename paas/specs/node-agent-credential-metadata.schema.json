{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/node-agent-credential-metadata.schema.json",
  "title": "Palimpsest Node Agent Credential Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["host_id", "key_id", "state", "created_at"],
  "properties": {
    "host_id": { "type": "string", "minLength": 1 },
    "key_id": { "type": "string", "minLength": 1 },
    "state": { "enum": ["active", "rotated", "revoked"] },
    "created_at": { "type": "string", "minLength": 1 },
    "rotated_at": { "type": ["string", "null"] },
    "revoked_at": { "type": ["string", "null"] },
    "last_used_at": { "type": ["string", "null"] },
    "last_used_operation": { "type": ["string", "null"] }
  }
}
