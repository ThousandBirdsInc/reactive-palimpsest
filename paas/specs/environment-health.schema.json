{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Palimpsest PaaS Customer Environment Health",
  "type": "object",
  "required": ["environment_id", "state", "summary", "components"],
  "additionalProperties": false,
  "properties": {
    "environment_id": { "type": "string", "minLength": 1 },
    "state": { "$ref": "#/$defs/health_state" },
    "summary": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "health_state": {
      "type": "string",
      "enum": ["healthy", "degraded", "at_risk", "maintenance", "unavailable"]
    },
    "component": {
      "type": "object",
      "required": ["name", "state", "detail"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/health_state" },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
