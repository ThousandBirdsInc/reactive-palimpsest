{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/secret-rewrap-plan.schema.json",
  "title": "Palimpsest Secret Rewrap Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "source_key_ref",
    "target_key_ref",
    "status",
    "matched_secret_count",
    "rewrapped_secret_count",
    "created_at"
  ],
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "source_key_ref": { "type": "string", "minLength": 1 },
    "target_key_ref": { "type": "string", "minLength": 1 },
    "status": { "enum": ["planned", "running", "succeeded", "failed"] },
    "matched_secret_count": { "type": "integer", "minimum": 0 },
    "rewrapped_secret_count": { "type": "integer", "minimum": 0 },
    "error_message": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": ["string", "null"] }
  }
}
