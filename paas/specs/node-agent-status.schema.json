{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/node-agent-status.schema.json",
  "title": "Palimpsest Node Agent Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host_id",
    "cluster_id",
    "observed_state",
    "postgres_running",
    "postgres_version",
    "backup_status",
    "wal_archive_status",
    "detail"
  ],
  "properties": {
    "host_id": { "type": "string", "minLength": 1 },
    "cluster_id": { "type": "string", "minLength": 1 },
    "observed_state": {
      "enum": [
        "requested",
        "placing",
        "allocating_storage",
        "initializing_postgres",
        "configuring_roles",
        "configuring_replication",
        "starting",
        "verifying",
        "ready",
        "stopping",
        "stopped",
        "deleting",
        "deleted",
        "failed"
      ]
    },
    "postgres_running": { "type": "boolean" },
    "postgres_version": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^(1[8-9]|[2-9][0-9])([.-].*)?$"
        }
      ]
    },
    "backup_status": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/backup_status" }
      ]
    },
    "wal_archive_status": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/wal_archive_status" }
      ]
    },
    "detail": {
      "anyOf": [
        { "type": "null" },
        { "type": "string" }
      ]
    }
  },
  "$defs": {
    "backup_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_base_backup_id",
        "last_base_backup_at",
        "last_successful_restore_check_at",
        "pitr_window_hours",
        "state"
      ],
      "properties": {
        "last_base_backup_id": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "last_base_backup_at": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "last_successful_restore_check_at": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "pitr_window_hours": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["unknown", "healthy", "degraded", "failed"] }
      }
    },
    "wal_archive_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_archived_lsn",
        "latest_archived_at",
        "archive_lag_bytes",
        "state"
      ],
      "properties": {
        "latest_archived_lsn": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "latest_archived_at": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "archive_lag_bytes": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "state": { "enum": ["unknown", "streaming", "lagging", "failed"] }
      }
    }
  }
}
