{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/managed-postgres-major-upgrade.schema.json",
  "title": "Palimpsest Managed Postgres Major Upgrade",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "upgrade_id",
    "cluster_id",
    "source_postgres_version",
    "target_postgres_version",
    "strategy",
    "status",
    "created_at"
  ],
  "properties": {
    "upgrade_id": { "type": "string", "minLength": 1 },
    "cluster_id": { "type": "string", "minLength": 1 },
    "source_postgres_version": {
      "type": "string",
      "pattern": "^(1[8-9]|[2-9][0-9])([.-].*)?$"
    },
    "target_postgres_version": {
      "type": "string",
      "pattern": "^(1[8-9]|[2-9][0-9])([.-].*)?$"
    },
    "strategy": { "enum": ["logical_replication_copy", "pg_upgrade_copy"] },
    "status": { "enum": ["running", "succeeded", "failed", "cancelled"] },
    "command_id": { "type": ["string", "null"] },
    "operation_id": { "type": ["string", "null"] },
    "error_message": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": ["string", "null"] }
  }
}
