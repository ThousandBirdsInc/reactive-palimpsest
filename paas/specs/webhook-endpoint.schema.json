{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/webhook-endpoint.schema.json",
  "title": "Palimpsest Webhook Endpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint_id",
    "organization_id",
    "project_id",
    "environment_id",
    "name",
    "url",
    "event_types",
    "signing_secret_ref",
    "status"
  ],
  "properties": {
    "endpoint_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": ["string", "null"] },
    "environment_id": { "type": ["string", "null"] },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "minLength": 1 },
    "event_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "signing_secret_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["secret_id", "provider", "external_ref"],
      "properties": {
        "secret_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "external_ref": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "enum": ["active", "disabled"] }
  }
}
