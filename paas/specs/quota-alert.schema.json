{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.dev/schemas/paas/quota-alert.schema.json",
  "title": "Palimpsest Quota Alert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_id",
    "policy_id",
    "organization_id",
    "project_id",
    "environment_id",
    "metric",
    "threshold_basis_points",
    "current_quantity",
    "limit_quantity",
    "window_seconds",
    "state",
    "last_evaluated_at",
    "fired_at",
    "resolved_at"
  ],
  "properties": {
    "alert_id": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "metric": {
      "enum": [
        "postgres_storage_gib_hours",
        "postgres_wal_bytes",
        "postgres_backup_bytes",
        "sync_egress_bytes",
        "sync_connection_minutes"
      ]
    },
    "threshold_basis_points": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "current_quantity": { "type": "integer", "minimum": 0 },
    "limit_quantity": { "type": "integer", "minimum": 0 },
    "window_seconds": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["ok", "firing"] },
    "last_evaluated_at": { "type": ["string", "null"] },
    "fired_at": { "type": ["string", "null"] },
    "resolved_at": { "type": ["string", "null"] }
  }
}
